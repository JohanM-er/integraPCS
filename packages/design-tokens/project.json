{
  "name": "packages-design-tokens",
  "sourceRoot": "packages/design-tokens/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf dist/packages/design-tokens",
          "mkdir -p dist/packages/design-tokens/src",
          "cp -R packages/design-tokens/src/* dist/packages/design-tokens/src/"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No TypeScript sources to typecheck for design-tokens\""
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No specific lint config for packages/design-tokens yet\""
      }
    }
  },
  "tags": [
    "scope:package",
    "type:lib"
  ]
}