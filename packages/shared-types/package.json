{
  "name": "@integrapcs/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types for integraPCS application",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "keywords": [
    "types",
    "typescript",
    "integrapcs",
    "domain",
    "events"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "5.9.3"
  }
}