# Backend Environment Variables Example
# Copy to .env and update values as needed.

# Node Environment
NODE_ENV=development

# GraphQL Server Configuration
GRAPHQL_PORT=3000
GRAPHQL_PATH=/graphql
# Subscriptions will use the same path via graphql-ws
SUBSCRIPTIONS_PATH=/graphql

# CORS configuration (Frontend origin for dev)
FRONTEND_ORIGIN=http://localhost:5173
# PRODUCTION_ORIGIN=https://integrapcs.com
# STAGING_ORIGIN=https://staging.integrapcs.com

# Neo4j Database Configuration
# When using Docker: neo4j container uses password123
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
# Production: Enable TLS encryption
NEO4J_ENCRYPTED=false
NEO4J_TRUST_STRATEGY=TRUST_SYSTEM_CA_SIGNED_CERTIFICATES

# RabbitMQ (Event Bus / Outbox)
# Default user/pass match docker-compose
RABBITMQ_URL=amqp://scheduler:password123@localhost:5672/
# Production: Use amqps:// with TLS
# RABBITMQ_URL=amqps://user:pass@rabbitmq.example.com:5671
RABBITMQ_TLS_ENABLED=false
# RABBITMQ_TLS_CA_CERT=/certs/rabbitmq-ca.crt
# RABBITMQ_TLS_CERT=/certs/rabbitmq-client.crt
# RABBITMQ_TLS_KEY=/certs/rabbitmq-client.key

# Redis (PubSub for GraphQL subscriptions + Rate Limiting)
REDIS_URL=redis://localhost:6379
# Production: Enable TLS encryption
REDIS_TLS_ENABLED=false
# REDIS_TLS_CA_CERT=/certs/redis-ca.crt
# REDIS_TLS_CERT=/certs/redis-client.crt
# REDIS_TLS_KEY=/certs/redis-client.key

# JWT Authentication
JWT_SECRET=your-secret-key-min-36-characters-change-in-production
JWT_EXPIRES_IN=7d

# Logging
# Levels: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=debug