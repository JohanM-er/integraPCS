{
  "name": "jobs-outbox-publisher",
  "sourceRoot": "apps/jobs/outbox-publisher/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/jobs/outbox-publisher/tsconfig.json --outDir dist/apps/jobs/outbox-publisher"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/jobs/outbox-publisher/main.js",
        "dependsOn": ["jobs-outbox-publisher:build"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/jobs/outbox-publisher/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No specific lint config for jobs/outbox-publisher yet\""
      }
    }
  },
  "tags": [
    "scope:app",
    "type:job"
  ]
}