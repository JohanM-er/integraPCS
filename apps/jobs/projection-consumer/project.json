{
  "name": "jobs-projection-consumer",
  "sourceRoot": "apps/jobs/projection-consumer/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/jobs/projection-consumer/tsconfig.json --outDir dist/apps/jobs/projection-consumer"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/jobs/projection-consumer/main.js",
        "dependsOn": ["jobs-projection-consumer:build"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/jobs/projection-consumer/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No specific lint config for jobs/projection-consumer yet\""
      }
    }
  },
  "tags": [
    "scope:app",
    "type:job"
  ]
}