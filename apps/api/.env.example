# API Gateway Environment Variables Example
# Copy to .env and update values as needed.

# Node Environment
NODE_ENV=development

# GraphQL Server Configuration
GRAPHQL_PORT=3000
GRAPHQL_PATH=/graphql
# Subscriptions will use the same path via graphql-ws
SUBSCRIPTIONS_PATH=/graphql

# CORS configuration (Frontend origin for dev)
FRONTEND_ORIGIN=http://localhost:5173
# PRODUCTION_ORIGIN=https://integrapcs.com
# STAGING_ORIGIN=https://staging.integrapcs.com

# Redis (Rate Limiting)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-secret-key-min-36-characters-change-in-production
JWT_EXPIRES_IN=7d

# Logging
# Levels: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=debug