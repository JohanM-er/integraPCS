{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "../../dist/apps/api",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "../../dist/.tsbuildinfo/apps-api.tsbuildinfo",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "../../platform/auth" },
    { "path": "../../platform/config" },
    { "path": "../../platform/db" },
    { "path": "../../platform/graphql" },
    { "path": "../../platform/messaging" },
    { "path": "../../platform/observability" },
    { "path": "../../platform/security" },
    { "path": "../../shared/common" },
    { "path": "../../shared/kernel" },
    { "path": "../../shared/patterns" },
    { "path": "../../contexts/work-package/tsconfig.lib.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}