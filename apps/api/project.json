{
  "name": "api",
  "sourceRoot": "apps/api/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -b apps/api/tsconfig.json && node scripts/build/link-runtime-aliases.mjs apps/api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["api:build"],
      "options": {
        "command": "node dist/apps/api/main.js"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/api/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No specific lint config for apps/api yet\""
      }
    }
  },
  "tags": [
    "scope:app",
    "type:api"
  ]
}