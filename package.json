{
  "name": "integrapcs-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "integraPCS monorepo: GraphQL backend and React frontend with shared types",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nx run-many -t serve --parallel",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test --parallel",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "clean": "nx run-many -t clean --if-present && rm -rf node_modules",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:fix:force": "npm audit fix --force",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "generate:demos": "node scripts/generate-token-demos.mjs",
    "check:tailwind": "node scripts/check-tailwind-arbitrary.mjs",
    "prepare": "husky"
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/design-tokens",
    "packages/shared-types"
  ],
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@graphql-tools/schema": "^10.0.19",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "rate-limit-redis": "^4.2.0",
    "amqplib": "^0.10.9",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "glob": "^11.0.3",
    "graphql": "16.11.0",
    "graphql-ws": "^5.14.2",
    "ioredis": "^5.6.1",
    "neo4j-driver": "^5.28.1",
    "pino": "^9.8.0",
    "storybook": "10.1.11",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/node": "22.3.3",
    "@nx/playwright": "22.3.3",
    "@nx/react": "22.3.3",
    "@nx/storybook": "22.3.3",
    "@nx/vite": "22.3.3",
    "@nx/vitest": "22.3.3",
    "chalk": "^5.4.1",
    "chromatic": "^13.3.0",
    "husky": "^9.1.4",
    "jiti": "2.4.2",
    "nx": "22.3.3",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "stylelint": "^16.9.0",
    "stylelint-config-recommended": "^14.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "typescript": "5.9.3"
  }
}
