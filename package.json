{
  "name": "integrapcs-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "integraPCS monorepo: GraphQL backend and React frontend with shared types",
  "scripts": {
    "dev": "./dev-start.sh",
    "build": "npm run build -w packages/shared-types && npm run build -w backend && npm run build -w frontend",
    "build:shared": "npm run build -w packages/shared-types",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test -w backend && npm run test -w frontend",
    "test:e2e": "npm run test:e2e -w frontend",
    "test:integration": "npm -w backend run test:integration --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:fix:force": "npm audit fix --force",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "generate:demos": "node scripts/generate-token-demos.mjs",
    "check:tailwind": "node scripts/check-tailwind-arbitrary.mjs",
    "prepare": "husky"
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/design-tokens",
    "packages/shared-types"
  ],
  "dependencies": {
    "glob": "^11.0.3"
  },
  "devDependencies": {
    "chalk": "^5.4.1",
    "chromatic": "^13.3.0",
    "husky": "^9.1.4",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "stylelint": "^16.9.0",
    "stylelint-config-recommended": "^14.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "typescript": "5.9.3"
  }
}
