{
  "name": "shared-kernel",
  "sourceRoot": "shared/kernel/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p shared/kernel/tsconfig.json"
      },
      "outputs": ["{workspaceRoot}/dist/shared/kernel"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p shared/kernel/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No specific lint config for shared/kernel yet\""
      }
    }
  },
  "tags": [
    "scope:shared",
    "type:lib",
    "layer:domain"
  ]
}
