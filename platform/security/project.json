{
  "name": "platform-security",
  "sourceRoot": "platform/security/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "platform/security/src/index.ts",
        "outputPath": "dist/platform/security",
        "tsConfig": "platform/security/tsconfig.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p platform/security/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No specific lint config for platform/security yet\""
      }
    }
  },
  "tags": [
    "scope:platform",
    "type:lib"
  ]
}
