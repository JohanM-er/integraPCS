{
  "name": "platform-graphql",
  "sourceRoot": "platform/graphql/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p platform/graphql/tsconfig.json"
      },
      "outputs": ["{workspaceRoot}/dist/platform/graphql"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p platform/graphql/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No specific lint config for platform/graphql yet\""
      }
    }
  },
  "tags": [
    "scope:platform",
    "type:lib"
  ]
}
