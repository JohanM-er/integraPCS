{
  "name": "contexts-work-package",
  "sourceRoot": "contexts/work-package/src",
  "implicitDependencies": [
    "shared-kernel",
    "shared-patterns",
    "shared-common",
    "platform-db",
    "platform-graphql"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "npx tsc -p contexts/work-package/tsconfig.lib.json"
      },
      "outputs": ["{workspaceRoot}/dist/contexts/work-package"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p contexts/work-package/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No specific lint config for contexts/work-package yet\""
      }
    }
  },
  "tags": [
    "scope:context:work-package",
    "layer:interfaces"
  ]
}
