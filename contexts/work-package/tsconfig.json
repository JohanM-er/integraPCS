{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "rootDir": "./src",
    "outDir": "../../dist/contexts/work-package",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "../../dist/contexts/work-package/tsconfig.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "../../shared/kernel" },
    { "path": "../../shared/patterns" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.d.ts",
    "generated"
  ]
}