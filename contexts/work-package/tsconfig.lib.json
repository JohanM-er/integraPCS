{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "composite": true,
    "incremental": true,
    "rootDir": "./src",
    "outDir": "../../dist/contexts/work-package",
    "tsBuildInfoFile": "../../dist/contexts/work-package/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "../../dist/shared/*",
        "../../dist/shared/*/index.d.ts"
      ]
    }
  },
  "references": [
    { "path": "../../shared/kernel" },
    { "path": "../../shared/patterns" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
