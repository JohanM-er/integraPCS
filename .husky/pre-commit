#!/usr/bin/env bash
. "$(dirname -- "$0")/_/husky.sh"

# Enhanced Pre-commit Hook
#
# Performs checks before allowing commits:
# - Detects .only() in tests (BLOCKING)
# - Checks for console.log statements in tests (WARNING)
# - Validates test naming/structure (WARNING)
# - TypeScript compilation for staged .ts files (WARNING)
# - Validates imports (flags require() usage) (WARNING)
#
# Removed from schedNeoOrg template for integraPCS POC:
# - Test categorization / pattern usage checks
# - References to backend/test-categories.json

echo "🔍 Running pre-commit checks for integraPCS..."

# Configuration
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

MAX_CONSOLE_LOGS=0  # Maximum allowed console.log in tests

# Track results
ERRORS=0
WARNINGS=0

log_error() {
    echo -e "${RED}❌ ERROR: $1${NC}"
    ((ERRORS++))
}

log_warning() {
    echo -e "${YELLOW}⚠️  WARNING: $1${NC}"
    ((WARNINGS++))
}

log_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

log_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
TEST_FILES=$(echo "$STAGED_FILES" | grep -E '\.(test|spec)\.(ts|js|tsx|jsx)$' 2>/dev/null || true)
JS_TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|js|tsx|jsx)$' 2>/dev/null || true)

if [ -z "$TEST_FILES" ] && [ -z "$JS_TS_FILES" ]; then
    log_info "No test or JS/TS files staged, skipping pre-commit checks"
    exit 0
fi

log_info "Checking $(echo "$TEST_FILES" | wc -l) test files and $(echo "$JS_TS_FILES" | wc -l) JS/TS files..."

# Check 1: Detect .only() in test files (BLOCKING)
check_test_only() {
    log_info "Checking for .only() in test files..."

    if [ -n "$TEST_FILES" ]; then
        ONLY_FILES=$(echo "$TEST_FILES" | xargs grep -l "\.only(" 2>/dev/null || true)

        if [ -n "$ONLY_FILES" ]; then
            log_error "Found .only() in test files - must be removed before commit:"
            echo "$ONLY_FILES" | while read -r file; do
                echo "  📁 $file"
                grep -n "\.only(" "$file" | head -3 | while read -r line; do
                    echo "    🔍 $line"
                done
            done
            return 1
        else
            log_success "No .only() found in test files"
        fi
    fi
    return 0
}

# Check 2: Console.log detection (WARNING)
check_console_logs() {
    log_info "Checking for console.log statements in test files..."

    CONSOLE_COUNT=0
    if [ -n "$TEST_FILES" ]; then
        CONSOLE_FILES=$(echo "$TEST_FILES" | xargs grep -l "console\.log" 2>/dev/null || true)
        if [ -n "$CONSOLE_FILES" ]; then
            CONSOLE_COUNT=$(echo "$CONSOLE_FILES" | wc -l)
        fi
    fi

    if [ "$CONSOLE_COUNT" -gt "$MAX_CONSOLE_LOGS" ]; then
        log_warning "Found $CONSOLE_COUNT console.log statements in test files"
        log_info "Consider using the Pino logger instead of console.log"
    else
        log_success "No problematic console.log statements found"
    fi
}

# Check 3: Test naming conventions (WARNING)
check_test_naming() {
    log_info "Validating test naming conventions..."

    if [ -n "$TEST_FILES" ]; then
        NAMING_ISSUES=0
        echo "$TEST_FILES" | while read -r file; do
            if [ -n "$file" ] && [ -f "$file" ]; then
                # Check for proper test structure
                if ! grep -qE "describe\(|it\(|test\(" "$file"; then
                    log_warning "Test file may be missing proper test structure: $file"
                    ((NAMING_ISSUES++))
                fi

                # Check for TODO or FIXME without .skip
                if grep -qE "TODO|FIXME" "$file" && ! grep -q "\.skip" "$file"; then
                    log_warning "Found TODO/FIXME in test without .skip(): $file"
                fi
            fi
        done

        if [ "$NAMING_ISSUES" -eq 0 ]; then
            log_success "Test naming conventions look good"
        fi
    fi
}

# Check 4: TypeScript compilation for staged TS files (WARNING)
check_typescript_compilation() {
    log_info "Checking TypeScript compilation for staged files..."

    TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.ts(x)?$' 2>/dev/null || true)

    if [ -n "$TS_FILES" ]; then
        # Create temporary tsconfig for staged files only
        TEMP_CONFIG=$(mktemp)
        # Build a JSON array of files
        FILES_JSON=$(echo "$TS_FILES" | awk 'NF' | sed 's/"/\\"/g' | sed 's/^/"/;s/$/"/' | paste -sd, -)
        cat > "$TEMP_CONFIG" << EOF
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "files": [${FILES_JSON}]
}
EOF

        if npx tsc --project "$TEMP_CONFIG" >/dev/null 2>&1; then
            log_success "TypeScript compilation passed"
        else
            log_warning "TypeScript compilation failed for staged files"
            npx tsc --project "$TEMP_CONFIG" 2>&1 | head -20
            ((WARNINGS++))
        fi

        rm -f "$TEMP_CONFIG"
    else
        log_info "No staged TypeScript files detected"
    fi
}

# Check 5: Import statement validation (WARNING)
check_import_statements() {
    log_info "Validating import statements (flagging require())..."

    if [ -n "$JS_TS_FILES" ]; then
        REQUIRE_ISSUES=$(echo "$JS_TS_FILES" | xargs grep -l "require(" 2>/dev/null || true)

        if [ -n "$REQUIRE_ISSUES" ]; then
            log_warning "Found require() statements that should be ES module imports:"
            echo "$REQUIRE_ISSUES" | head -10 | while read -r file; do
                echo "  📁 $file"
                grep -n "require(" "$file" | head -3 | while read -r line; do
                    echo "    🔍 $line"
                done
            done
            log_info "Convert require() to ES6 import statements"
        else
            log_success "No problematic require() statements found"
        fi
    fi
}

# Run all checks
echo ""
echo "🚀 Running pre-commit quality checks..."
echo "======================================"

check_test_only || exit 1  # Blocking check
check_console_logs
check_test_naming
check_typescript_compilation
check_import_statements

echo ""
echo "======================================"

# Summary
if [ "$ERRORS" -gt 0 ]; then
    echo -e "${RED}❌ Pre-commit failed with $ERRORS errors${NC}"
    echo "Please fix the errors above before committing."
    exit 1
elif [ "$WARNINGS" -gt 0 ]; then
    echo -e "${YELLOW}⚠️  Pre-commit passed with $WARNINGS warnings${NC}"
    echo "Consider addressing the warnings above."
    echo ""
    echo -e "${GREEN}✅ Commit allowed${NC}"
else
    echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
fi

echo ""